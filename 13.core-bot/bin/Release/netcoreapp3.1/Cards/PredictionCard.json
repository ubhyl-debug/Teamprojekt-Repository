{
    "type": "AdaptiveCard",
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.3",
    "body": [
        {
            "type": "TextBlock",
            "wrap": true,
            "text": "New Booking Prediction",
            "size": "Medium",
            "weight": "Bolder",
            "horizontalAlignment": "Center"
        },
        {
            "type": "Container",
            "items": [
                {
                    "type": "ColumnSet",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "wrap": true,
                                    "text": "Prediction of cancellation:",
                                    "isSubtle": true,
                                    "weight": "Bolder"
                                }
                            ],
                            "verticalContentAlignment": "Center"
                        },
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "${prediction}",
                                    "wrap": true,
                                    "size": "ExtraLarge",
                                    "horizontalAlignment": "Right"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "ColumnSet",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "FactSet",
                                    "facts": [
                                        {
                                            "title": "Deposit type",
                                            "value": "${deposit_type}"
                                        },
                                        {
                                            "title": "Agent",
                                            "value": "${agent}"
                                        },
                                        {
                                            "title": "Country",
                                            "value": "${country}"
                                        },
                                        {
                                            "title": "Special requests",
                                            "value": "${special_requests}"
                                        },
                                        {
                                            "title": "Lead time",
                                            "value": "${lead_time}"
                                        },
                                        {
                                            "title": "Customer type",
                                            "value": "${customer_type}"
                                        },
                                        {
                                            "title": "Parking space",
                                            "value": "${parking_space}"
                                        },
                                        {
                                            "title": "Prev. cancellations",
                                            "value": "${previous_cancellations}"
                                        },
                                        {
                                            "title": "Arrival week",
                                            "value": "${arrival_date_week_number}"
                                        },
                                        {
                                            "title": "Booking changes",
                                            "value": "${booking_changes}"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "wrap": true,
                                    "text": "${difference}",
                                    "isSubtle": true,
                                    "weight": "Bolder",
                                    "horizontalAlignment": "Right"
                                },
                                {
                                    "type": "ColumnSet",
                                    "columns": [
                                        {
                                            "type": "Column",
                                            "width": "stretch"
                                        },
                                        {
                                            "type": "Column",
                                            "width": "stretch"
                                        },
                                        {
                                            "type": "Column",
                                            "width": "stretch",
                                            "items": [
                                                {
                                                    "type": "Image",
                                                    "size": "Small",
                                                    "height": "20px",
                                                    "$when": "${higher == false}",
                                                    "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/6/6e/Green_Arrow_Down.svg/900px-Green_Arrow_Down.svg.png",
                                                    "horizontalAlignment": "Center"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "Column",
                                            "width": "stretch",
                                            "items": [
                                                {
                                                    "type": "Image",
                                                    "height": "20px",
                                                    "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/1/13/Red_Arrow_Up.svg/2048px-Red_Arrow_Up.svg.png",
                                                    "$when": "${higher == true}"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "type": "ColumnSet",
                                    "columns": [
                                        {
                                            "type": "Column",
                                            "width": "stretch"
                                        },
                                        {
                                            "type": "Column",
                                            "width": "stretch"
                                        }
                                    ]
                                },
                                {
                                    "type": "ActionSet",
                                    "actions": [
                                        {
                                            "type": "Action.ToggleVisibility",
                                            "title": "Show all Details"
                                        }
                                    ]
                                },
                                {
                                    "type": "ActionSet",
                                    "actions": [
                                        {
                                            "type": "Action.Submit",
                                            "title": "Edit booking"
                                        }
                                    ]
                                },
                                {
                                    "type": "ActionSet",
                                    "actions": [
                                        {
                                            "type": "Action.ShowCard",
                                            "card": {
                                                "type": "AdaptiveCard"
                                            },
                                            "title": "Compare local SHAP"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "ColumnSet",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "stretch"
                        },
                        {
                            "type": "Column",
                            "width": "stretch"
                        },
                        {
                            "type": "Column",
                            "width": "stretch"
                        },
                        {
                            "type": "Column",
                            "width": "stretch"
                        },
                        {
                            "type": "Column",
                            "width": "stretch"
                        },
                        {
                            "type": "Column",
                            "width": "stretch"
                        },
                        {
                            "type": "Column",
                            "width": "stretch",
                            "horizontalAlignment": "Right"
                        },
                        {
                            "type": "Column",
                            "width": "stretch"
                        },
                        {
                            "type": "Column",
                            "width": "stretch"
                        }
                    ]
                }
            ],
            "backgroundImage": {
                "url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8+PnLJwAJgQPM6nTTyQAAAABJRU5ErkJggg=="
            }
        }
    ]
}