{
    "type": "AdaptiveCard",
    "body": [
        {
            "type": "TextBlock",
            "size": "Medium",
            "weight": "Bolder",
            "text": "Chatbot Hannes",
            "horizontalAlignment": "Center"
        },
        {
            "type": "ColumnSet",
            "columns": [
                {
                    "type": "Column",
                    "items": [
                        {
                            "type": "Image",
                            "style": "Person",
                            "url": "data:image/png;base64,",
                            "size": "Small"
                        }
                    ],
                    "width": "auto"
                },
                {
                    "type": "Column",
                    "items": [
                        {
                            "type": "TextBlock",
                            "weight": "Bolder",
                            "text": "Hi! My name is Hannes. I am your virtual assistent and I'm here to explain the AI to you. ",
                            "wrap": true,
                            "horizontalAlignment": "Center"
                        }
                    ],
                    "width": "stretch"
                }
            ]
        },
        {
            "type": "Container"
        },
        {
            "type": "Container",
            "items": [
                {
                    "type": "Container"
                }
            ]
        },
        {
            "type": "Container"
        },
        {
            "type": "Container"
        },
        {
            "type": "TextBlock",
            "wrap": true,
            "text": "My Prediction for your selected booking is:",
            "horizontalAlignment": "Center",
            "weight": "Bolder"
        },
        {
            "type": "TextBlock",
            "wrap": true,
            "horizontalAlignment": "Center",
            "text": "${prediction}",
            "size": "Large"
        }
    ],
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.3"
}