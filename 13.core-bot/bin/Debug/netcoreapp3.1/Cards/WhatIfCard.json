{
    "type": "AdaptiveCard",
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.3",
    "body": [
        {
            "type": "TextBlock",
            "wrap": true,
            "weight": "Bolder",
            "size": "Medium",
            "horizontalAlignment": "Center",
            "text": "What if Explanation"
        },
        {
            "type": "ColumnSet",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "TextBlock",
                            "wrap": true,
                            "text": "Features",
                            "weight": "Bolder",
                            "isSubtle": true,
                            "size": "Medium"
                        }
                    ],
                    "verticalContentAlignment": "Bottom"
                },
                {
                    "type": "Column",
                    "width": "stretch",
                    "verticalContentAlignment": "Bottom"
                }
            ]
        },
        {
            "type": "ColumnSet",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "Input.ChoiceSet",
                            "choices": [
                                {
                                    "title": "No Deposit",
                                    "value": "No Deposit"
                                },
                                {
                                    "title": "Non Refund",
                                    "value": "Non Refund"
                                },
                                {
                                    "title": "Refundable",
                                    "value": "Refundable"
                                }
                            ],
                            "placeholder": "Placeholder text",
                            "id": "deposit_type",
                            "label": "Deposit type"
                        }
                    ]
                }
            ]
        },
        {
            "type": "ColumnSet",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "Input.Number",
                            "placeholder": "Placeholder text",
                            "id": "agent",
                            "label": "Agent"
                        }
                    ]
                }
            ]
        },
        {
            "type": "ColumnSet",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "Input.Text",
                            "id": "country",
                            "placeholder": "Placeholder text",
                            "label": "Country"
                        }
                    ]
                }
            ]
        },
        {
            "type": "ColumnSet",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "Input.Number",
                            "placeholder": "Placeholder text",
                            "id": "total_of_special_requests",
                            "label": "Special requets"
                        }
                    ]
                }
