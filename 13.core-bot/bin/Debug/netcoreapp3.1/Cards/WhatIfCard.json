        {
            "type": "ActionSet",
            "actions": [
                {
                    "type": "Action.ToggleVisibility",
                    "title": "Add Features",
                    "targetElements": [
                        "ToogleArrivalDateYear",
                        "ToggleDayOfMonth",
                        "ToggleWeeknights",
                        "TogglePrevious",
                        "ToggleAdr",
                        "ToggleSegment",
                        "ToggleDistribution",
                        "ToggleMeal",
                        "ToggleCompany",
                        "ToogleChildren",
                        "ToggleRoom",
                        "ToggleStaysinWeekend",
                        "ToggleAdults",
                        "ToggleRepeated",
