                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "Input.ChoiceSet",
                            "choices": [
                                {
                                    "title": "Transient",
                                    "value": "Transient"
                                },
                                {
                                    "title": "Transient-Party",
                                    "value": "Transient-Party"
                                },
                                {
                                    "title": "Contract",
                                    "value": "Contract"
                                },
                                {
                                    "title": "Group",
                                    "value": "Group"
