{
    "type": "AdaptiveCard",
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.3",
    "body": [
        {
            "type": "TextBlock",
            "wrap": true,
            "text": "New Booking Prediction",
            "size": "Medium",
            "weight": "Bolder",
            "horizontalAlignment": "Center"
        },
        {
            "type": "ColumnSet",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "TextBlock",
                            "wrap": true,
                            "text": "The prediction of your specified booking is:"
                        }
                    ]
                }
            ]
        },
        {
            "type": "Container",
            "items": [
                {
                    "type": "ColumnSet",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "wrap": true,
                                    "text": "Prediction of cancellation:",
                                    "isSubtle": true,
                                    "weight": "Bolder"
                                }
                            ],
                            "verticalContentAlignment": "Center"
                        },
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "${prediction}",
                                    "wrap": true,
                                    "size": "ExtraLarge",
                                    "horizontalAlignment": "Right"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "ColumnSet",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "stretch"
                        },
                        {
                            "type": "Column",
                            "width": "stretch"
                        },
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "ColumnSet",
                                    "columns": [
                                        {
                                            "type": "Column",
                                            "width": "stretch",
                                            "items": [
                                                {
                                                    "type": "Image",
                                                    "height": "20px",
                                                    "horizontalAlignment": "Right",
                                                    "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/1/13/Red_Arrow_Up.svg/2048px-Red_Arrow_Up.svg.png",
                                                    "$when": "${higher == true}"
                                                }
                                            ],
                                            "verticalContentAlignment": "Center"
                                        },
                                        {
                                            "type": "Column",
                                            "width": "stretch",
                                            "items": [
                                                {
                                                    "type": "Image",
                                                    "size": "Small",
                                                    "height": "20px",
                                                    "$when": "${higher == false}",
                                                    "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/6/6e/Green_Arrow_Down.svg/900px-Green_Arrow_Down.svg.png"
                                                }
                                            ],
                                            "height": "stretch",
                                            "verticalContentAlignment": "Center"
                                        }
                                    ],
                                    "height": "stretch"
                                }
                            ]
                        },
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "wrap": true,
                                    "text": "${difference}",
                                    "isSubtle": true,
                                    "weight": "Bolder"
                                }
                            ],
                            "verticalContentAlignment": "Center"
                        }
                    ]
                }
            ],
            "backgroundImage": {
                "url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8+PnLJwAJgQPM6nTTyQAAAABJRU5ErkJggg=="
            }
        }
    ]
}