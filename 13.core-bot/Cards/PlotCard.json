{
    "type": "AdaptiveCard",
    "body": [
        {
            "type": "TextBlock",
            "size": "Medium",
            "weight": "Bolder",
            "text": "${title}",
            "horizontalAlignment": "Center",
            "fontType": "Default"
        },
        {
            "type": "Image",
            "url": "${url}"
        },
        {
            "type": "Container",
            "selectAction": {
                "type": "Action.ToggleVisibility",
                "targetElements": [
                    "textualExplanation"
                ]
            },
            "items": [
                {
                    "type": "TextBlock",
                    "wrap": true,
                    "text": "Show Plot Description",
                    "size": "Small",
                    "horizontalAlignment": "Center",
                    "color": "Accent"
                }
            ]
        },
        {
            "type": "Container",
            "items": [
                {
                    "type": "TextBlock",
                    "text": "${textexpl}",
                    "id": "textualExplanation",
                    "horizontalAlignment": "Center",
                    "isVisible": false,
                    "wrap": true,
                    "color": "Dark",
                    "weight": "Lighter",
                    "size": "Small"
                }
            ],
            "style": "default"
        }
    ],
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.3"
}