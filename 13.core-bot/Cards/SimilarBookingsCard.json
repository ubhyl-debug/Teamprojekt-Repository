{
    "type": "AdaptiveCard",
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.3",
    "body": [
        {
            "type": "TextBlock",
            "wrap": true,
            "text": "Similar bookings",
            "horizontalAlignment": "Center",
            "size": "Medium",
            "weight": "Bolder"
        },
        {
            "type": "Container",
            "items": [
                {
                    "type": "ColumnSet",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "wrap": true,
                                    "text": "Count of similar bookings:",
                                    "size": "Medium",
                                    "weight": "Bolder"
                                }
                            ]
                        },
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "wrap": true,
                                    "text": "${count_of_similar_bookings}",
                                    "size": "ExtraLarge",
                                    "horizontalAlignment": "Right"
                                }
                            ]
                        }
                    ],
                    "style": "emphasis"
                },
                {
                    "type": "TextBlock",
                    "wrap": true,
                    "spacing": "Medium",
                    "horizontalAlignment": "Center",
                    "text": "The similarity is based on the 10 most important features"
                }
            ],
            "style": "emphasis"
        },
        {
            "type": "Container",
            "items": [
                {
                    "type": "TextBlock",
                    "wrap": true,
                    "text": "There were ${count_of_not_cancelled_bookings} similar bookings which were not cancelled.",
                    "size": "Medium"
                }
            ],
            "style": "good",
            "selectAction": {
                "type": "Action.ToggleVisibility"
            }
        },
        {
            "type": "ColumnSet",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "Container",
                            "selectAction": {
                                "type": "Action.OpenUrl"
                            },
                            "backgroundImage": {
                                "url": "google.de"
                            },
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "wrap": true,
                                    "text": "73636"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "Container"
                        }
                    ]
                },
                {
                    "type": "Column",
                    "width": "stretch"
                },
                {
                    "type": "Column",
                    "width": "stretch"
                },
                {
                    "type": "Column",
                    "width": "stretch"
                }
            ]
        },
        {
            "type": "Container",
            "items": [
                {
                    "type": "TextBlock",
                    "wrap": true,
                    "text": "There were ${count_of_cancelled_bookings} similar bookings which were cancelled.",
                    "size": "Medium"
                },
                {
                    "type": "ColumnSet",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "stretch"
                        },
                        {
                            "type": "Column",
                            "width": "stretch"
                        },
                        {
                            "type": "Column",
                            "width": "stretch"
                        },
                        {
                            "type": "Column",
                            "width": "stretch"
                        }
                    ],
                    "isVisible": false
                },
                {
                    "type": "ColumnSet",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "stretch"
                        },
                        {
                            "type": "Column",
                            "width": "stretch"
                        },
                        {
                            "type": "Column",
                            "width": "stretch"
                        },
                        {
                            "type": "Column",
                            "width": "stretch"
                        }
                    ],
                    "isVisible": false
                }
            ],
            "style": "attention",
            "selectAction": {
                "type": "Action.ToggleVisibility"
            }
        }
    ]
}